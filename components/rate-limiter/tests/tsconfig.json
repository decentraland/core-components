{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The package build compiles only `src`, so the specs would otherwise never be type-checked by
    // `tsc` — only by ts-jest at run time. This keeps them checked without emitting them into `dist`.
    "composite": false,
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["./**/*", "../src/**/*"]
}
